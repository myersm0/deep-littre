<text>
<body>
  <!-- a: @type on <note> -->
  <entry xml:id="probe_a" xml:lang="fr-x-lit19c" type="mainEntry">
    <form type="lemma"><orth norm="a">A</orth></form>
    <sense xml:id="probe_a_s1"><def>Définition.</def></sense>
    <note type="remarque">Commentaire.</note>
  </entry>
  <!-- b: untyped <note> control -->
  <entry xml:id="probe_b" xml:lang="fr-x-lit19c" type="mainEntry">
    <form type="lemma"><orth norm="b">B</orth></form>
    <sense xml:id="probe_b_s1"><def>Définition.</def></sense>
    <note>Commentaire.</note>
  </entry>
  <!-- c: @type on <sense> -->
  <entry xml:id="probe_c" xml:lang="fr-x-lit19c" type="mainEntry">
    <form type="lemma"><orth norm="c">C</orth></form>
    <sense xml:id="probe_c_s1" type="figuré"><def>Définition.</def></sense>
  </entry>
  <!-- d: @ana on <sense> control -->
  <entry xml:id="probe_d" xml:lang="fr-x-lit19c" type="mainEntry">
    <form type="lemma"><orth norm="d2">D</orth></form>
    <sense xml:id="probe_d_s1" ana="figurative"><def>Définition.</def></sense>
  </entry>
  <!-- e: cit type="attestation" inside etym -->
  <entry xml:id="probe_e" xml:lang="fr-x-lit19c" type="mainEntry">
    <form type="lemma"><orth norm="e2">E</orth></form>
    <sense xml:id="probe_e_s1"><def>Définition.</def></sense>
    <etym>Prose étymologique.
      <cit type="attestation"><quote>Attestation ancienne</quote><bibl><author>RONS.</author><biblScope>675</biblScope></bibl></cit>
    </etym>
  </entry>
  <!-- f: cit type="example" inside etym, control -->
  <entry xml:id="probe_f" xml:lang="fr-x-lit19c" type="mainEntry">
    <form type="lemma"><orth norm="f2">F</orth></form>
    <sense xml:id="probe_f_s1"><def>Définition.</def></sense>
    <etym>Prose étymologique.
      <cit type="example"><quote>Attestation ancienne</quote><bibl><author>RONS.</author><biblScope>675</biblScope></bibl></cit>
    </etym>
  </entry>
  <!-- g: date inside etym (expected invalid; confirms the 43,684 signature) -->
  <entry xml:id="probe_g" xml:lang="fr-x-lit19c" type="mainEntry">
    <form type="lemma"><orth norm="g2">G</orth></form>
    <sense xml:id="probe_g_s1"><def>Définition.</def></sense>
    <etym><date notBefore="1501" notAfter="1600">XVIe s.</date></etym>
  </entry>
  <!-- h: seg type="desc" century marker inside etym -->
  <entry xml:id="probe_h" xml:lang="fr-x-lit19c" type="mainEntry">
    <form type="lemma"><orth norm="h2">H</orth></form>
    <sense xml:id="probe_h_s1"><def>Définition.</def></sense>
    <etym><seg type="desc">XVIe s.</seg></etym>
  </entry>
  <!-- i: lbl century marker inside etym -->
  <entry xml:id="probe_i" xml:lang="fr-x-lit19c" type="mainEntry">
    <form type="lemma"><orth norm="i2">I</orth></form>
    <sense xml:id="probe_i_s1"><def>Définition.</def></sense>
    <etym><lbl>XVIe s.</lbl></etym>
  </entry>
  <!-- j: dictScrap with cit inside sense -->
  <entry xml:id="probe_j" xml:lang="fr-x-lit19c" type="mainEntry">
    <form type="lemma"><orth norm="j2">J</orth></form>
    <sense xml:id="probe_j_s1">
      <def>Définition.</def>
      <dictScrap><cit type="example"><quote>Exemple cité</quote></cit></dictScrap>
    </sense>
  </entry>
  <!-- k: cit as a direct child of entry -->
  <entry xml:id="probe_k" xml:lang="fr-x-lit19c" type="mainEntry">
    <form type="lemma"><orth norm="k2">K</orth></form>
    <sense xml:id="probe_k_s1"><def>Définition.</def></sense>
    <note>Commentaire.</note>
    <cit type="example"><quote>Exemple cité</quote><bibl><author>MOL.</author></bibl></cit>
  </entry>
  <!-- l: hi rend="italic" inside untyped note -->
  <entry xml:id="probe_l" xml:lang="fr-x-lit19c" type="mainEntry">
    <form type="lemma"><orth norm="l2">L</orth></form>
    <sense xml:id="probe_l_s1"><def>Définition.</def></sense>
    <note>Texte <hi rend="italic">italique</hi> dans la note.</note>
  </entry>
  <!-- m: xr with lbl and target-less ref inside untyped note -->
  <entry xml:id="probe_m" xml:lang="fr-x-lit19c" type="mainEntry">
    <form type="lemma"><orth norm="m2">M</orth></form>
    <sense xml:id="probe_m_s1"><def>Définition.</def></sense>
    <note>Voy. <xr type="related"><lbl>Voy.</lbl><ref type="entry">AGAME</ref></xr>.</note>
  </entry>
  <!-- n: usg type="hint" inside etym -->
  <entry xml:id="probe_n" xml:lang="fr-x-lit19c" type="mainEntry">
    <form type="lemma"><orth norm="n2">N</orth></form>
    <sense xml:id="probe_n_s1"><def>Définition.</def></sense>
    <etym><usg type="hint">fictif</usg></etym>
  </entry>
  <!-- o: bare cit inside dictScrap inside sense (attestation home if etym cits must be typed) -->
  <entry xml:id="probe_o" xml:lang="fr-x-lit19c" type="mainEntry">
    <form type="lemma"><orth norm="o2">O</orth></form>
    <sense xml:id="probe_o_s1">
      <def>Définition.</def>
      <dictScrap><cit><quote>Attestation</quote></cit></dictScrap>
    </sense>
  </entry>
  <!-- p: hi rend="italic" inside a synonymy xr (synonyme prose italics) -->
  <entry xml:id="probe_p" xml:lang="fr-x-lit19c" type="mainEntry">
    <form type="lemma"><orth norm="p2">P</orth></form>
    <sense xml:id="probe_p_s1"><def>Définition.</def></sense>
    <xr type="synonymy">Comparer <hi rend="italic">mot</hi> avec <ref type="entry">AUTRE</ref>.</xr>
  </entry>
  <!-- q: date inside bibl inside an etym citation (machine-readable century path) -->
  <entry xml:id="probe_q" xml:lang="fr-x-lit19c" type="mainEntry">
    <form type="lemma"><orth norm="q2">Q</orth></form>
    <sense xml:id="probe_q_s1"><def>Définition.</def></sense>
    <etym>Prose.
      <cit type="example" ana="attestation"><quote>Attestation</quote><bibl><author>RONS.</author><biblScope>675</biblScope><date notBefore="1501" notAfter="1600">XVIe s.</date></bibl></cit>
    </etym>
  </entry>
  <!-- r: ana on note (fallback carrier if note @type is the banned attribute) -->
  <entry xml:id="probe_r" xml:lang="fr-x-lit19c" type="mainEntry">
    <form type="lemma"><orth norm="r2">R</orth></form>
    <sense xml:id="probe_r_s1"><def>Définition.</def></sense>
    <note ana="remarque">Commentaire.</note>
  </entry>
  <!-- s: orth norm value coinciding with the entry's xml:id (duplicate-ID "d" mechanism) -->
  <entry xml:id="probe_s" xml:lang="fr-x-lit19c" type="mainEntry">
    <form type="lemma"><orth norm="probe_s">PROBE S</orth></form>
    <sense xml:id="probe_s_s1"><def>Définition.</def></sense>
  </entry>
  <!-- t: nested <hi> inside etym (redundant italics carried from the source) -->
  <entry xml:id="probe_t" xml:lang="fr-x-lit19c" type="mainEntry">
    <form type="lemma"><orth norm="t2">T</orth></form>
    <sense xml:id="probe_t_s1"><def>Définition.</def></sense>
    <etym><hi rend="italic" xml:lang="la">Quatuor qui <hi rend="italic">choream</hi> fecerunt</hi></etym>
  </entry>
  <!-- u: single-level <hi> inside etym, control -->
  <entry xml:id="probe_u" xml:lang="fr-x-lit19c" type="mainEntry">
    <form type="lemma"><orth norm="u2">U</orth></form>
    <sense xml:id="probe_u_s1"><def>Définition.</def></sense>
    <etym><hi rend="italic" xml:lang="la">Quatuor qui choream fecerunt</hi></etym>
  </entry>
</body>
</text>
</TEI>
